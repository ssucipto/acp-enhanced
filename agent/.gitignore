# Agent Context Protocol - Local Files
# These files are generated locally and should not be committed

# Local-only protocol dirs (clarifications/drafts/preferences)
clarifications/
drafts/**
!drafts/.gitkeep
!drafts/draft.template.md
preferences/

# ADR-27 — report/feedback bodies local; keepers tracked
reports/**
!reports/.gitkeep
!reports/README.md
feedback/**
!feedback/.gitkeep
!feedback/README.md

# ADR-28 — instance milestone/task/session bodies local; templates + keepers tracked
milestones/**
!milestones/.gitkeep
!milestones/README.md
!milestones/*.template.md
tasks/**
!tasks/.gitkeep
!tasks/README.md
!tasks/*.template.md
sessions/**
!sessions/.gitkeep
!sessions/README.md


