# Agent Context Protocol - Root .gitignore

# Legal documents (sensitive — not for version control)
IP_REGISTER.md

# Debug files (created during development/debugging)
debug.sh
debug-output.txt

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
# Cursor CI-run cache — local tool scratch, not project state (audit-109)
.cursor-gh-runs.json
*~

# Generated reports (audit findings, cost reports, etc.)
reports/
!agent/reports/

# Temporary files
*.tmp
*.temp

# Python (agent/scripts/acp.pref-resolve.py, M85 task-301)
__pycache__/
*.pyc

# Node / npm
node_modules/
package-lock.json
!scripts/package-lock.json
# Review-corpus fixtures are test data, not real dependency locks. Without this
# negation they are gitignored, so a fresh clone / CI checkout lacks them and the
# SC-15 negative case degrades into a false positive — corpus precision drops
# from 100% to 97.9% in CI only, silently, because the gate threshold is 90%
# (audit-107 G-107-07).
!tests/fixtures/**/package-lock.json
