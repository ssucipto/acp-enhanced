# Agent Context Protocol - Root .gitignore

# Legal documents (sensitive — not for version control)
IP_REGISTER.md

# Debug files (created during development/debugging)
debug.sh
debug-output.txt

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Generated reports (audit findings, cost reports, etc.)
reports/
!agent/reports/

# Temporary files
*.tmp
*.temp

# Node / npm
node_modules/
package-lock.json
!scripts/package-lock.json
